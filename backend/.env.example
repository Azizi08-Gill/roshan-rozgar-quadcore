MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/
MONGODB_DATABASE=roshan_rozgar
VEEVO_API_HASH=
VEEVO_SENDER=Default
# Hackathon only. Disable in production. Demo OTP never claims real phone verification.
DEMO_OTP_ENABLED=true
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=4000

# Google Gemini voice (speech-to-text, profile extraction, Urdu text-to-speech)
GEMINI_API_KEY=
# Optional comma-separated model lists, tried in order (next model on busy / rate limit / unavailable).
GEMINI_TRANSCRIBE_MODELS=gemini-3.5-transcribe,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Charon

# Backup only (not used): Groq + Edge TTS, see backend/legacy/groq-edge-tts
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# PYTHON_BIN=/absolute/path/to/python3
